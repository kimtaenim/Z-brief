# Z-brief webapp 환경변수
# 이 파일을 webapp/.env.local 로 복사 후 값 채우기. .env.local 은 절대 커밋 금지.

# Anthropic API. 미설정 시 mock 모드로 응답 (실제 호출 없음).
ANTHROPIC_API_KEY=

# Upstash Redis (선택). 미설정 시 메모리 캐시 + 메모리 카운터로 폴백.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 비밀번호 게이트. 페이지 진입 + 생성 호출에 모두 적용.
AUTH_PASSWORD=

# 일일 호출 상한 (IP 기준). 기본 10.
DAILY_LIMIT=10
