# Z-brief environment variables
# Copy to .env and fill in values. Never commit .env.

# Required for triage/summarize (Haiku + Sonnet calls).
# Without this key, only RSS fetch + filter (--dry-run) will work.
ANTHROPIC_API_KEY=

# Optional. Override default models if needed.
# ANTHROPIC_MODEL_TRIAGE=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_SUMMARIZE=claude-sonnet-4-6
